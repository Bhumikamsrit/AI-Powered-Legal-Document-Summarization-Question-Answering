{
  "name": "js-npl",
  "version": "1.0.0",
  "description": "A question-answering system for legal documents using NLP techniques.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server/server.js",
    "start:dev": "nodemon server/server.js",
    "convert-csv-to-json": "node convertCSVtoJSON.js",
    "analyze-bundle": "npm ls --depth=0",
    "preprocess-data": "node preprocess.js",
    "benchmark": "node scripts/benchmark.js",
    "clean": "rm -rf node_modules package-lock.json",
    "postinstall": "node scripts/optimize-deps.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "compromise": "^13.11.0",
    "csv-parser": "^3.0.0",
    "express": "^4.18.1",
    "node-summarizer": "^1.0.0",
    "onnxruntime-node": "^1.22.0",
    "body-parser": "^1.19.0",
    "dotenv": "^16.4.7",
    "natural": "^5.2.4",
    "openai": "^4.0.0",
    "uri-js": "^4.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "clinic": "^13.0.0",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "optionalDependencies": {
    "offscreen-canvas": "^0.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "Your Name",
  "license": "ISC",
  "bundleOptimizations": {
    "treeshaking": true,
    "minification": true,
    "compression": "gzip"
  },
  "onnxruntime": {
    "minimal": true,
    "providers": ["cpu"],
    "optimizationLevel": "extended"
  }
}
